# Copy this file to .env and replace the values with your hosting details.

CI_ENVIRONMENT = production

# Website URL. Include the final slash.
app.baseURL = 'https://your-domain.com/'

# Keep this false unless your hosting uses HTTPS correctly.
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

# MySQL database settings from your hosting provider.
database.default.hostname = localhost
database.default.database = your_database_name
database.default.username = your_database_user
database.default.password = your_database_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Encryption key. Generate a long random value for production.
encryption.key = 'replace-with-a-long-random-key'

# File-based sessions.
session.driver = 'CodeIgniter\\Session\\Handlers\\FileHandler'
session.savePath = WRITEPATH . 'session'

# Log only errors on the live site.
logger.threshold = 4
